# Secrets: API keys live in .env. Only the template is committed.
.env
.env.*
!.env.example

# Dependencies (dev tools only; reinstall with npm ci)
node_modules/
.npm

# Logs and Node diagnostic reports
logs
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Tool caches and test coverage
.eslintcache
coverage/
*.lcov
.node_repl_history

# Output of npm pack
*.tgz

# Claude Code: personal settings and worktrees stay local
# (shared project config such as .claude/launch.json can be committed)
.claude/settings.local.json
.claude/worktrees/

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
